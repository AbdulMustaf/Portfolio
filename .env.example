# ─── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# Any current Gemini model ID. Defaults to gemini-3.1-flash-lite when unset.
# Check availability before changing — Google retires models on a schedule, and
# a retired ID 404s on every call (gemini-2.0-flash-lite shut down 2026-06-01).
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── Cost controls ────────────────────────────────────────────────────────────
# Monthly ceiling for model spend. The endpoint stops calling Gemini and answers
# from the local rule engine once this is reached. A single day may spend at
# most 1/15th of it, so one scripted afternoon cannot drain the month.
RAG_MONTHLY_BUDGET_USD=2

# Hard ceiling on model calls per day. On the free tier this is the binding
# limit (Flash-Lite allows roughly 1000 requests/day); keep it under that.
RAG_MAX_MODEL_CALLS_PER_DAY=800

# Per-1M-token prices used to keep the spend ledger. Update these if you change
# GEMINI_MODEL, or the ledger will drift from your real bill.
# Defaults match gemini-3.1-flash-lite paid tier.
RAG_PRICE_INPUT_PER_M=0.25
RAG_PRICE_OUTPUT_PER_M=1.5

# ─── Health check ─────────────────────────────────────────────────────────────
# Secret for GET /api/rag-health?token=...  (add &probe=1 to test the model).
# Without it the route 404s. Generate: openssl rand -hex 16
RAG_HEALTH_TOKEN=

# ─── KV (Upstash / Vercel KV) ─────────────────────────────────────────────────
# Required for rate limiting, the spend ledger, the answer cache, and the
# persistent viewer count. Without these the RAG endpoint will not call Gemini
# at all — it fails closed to the rule engine, because an unmetered model call
# is how a fixed budget gets blown.
# Vercel Dashboard → Storage → Create KV Database → .env.local tab
KV_REST_API_URL=
KV_REST_API_TOKEN=
